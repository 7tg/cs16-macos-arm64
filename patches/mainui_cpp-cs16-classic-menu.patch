+static bool IsSettingsTabMenu( const char *n )
+{
+	return !strcmp( n, "CMenuOptions" ) || !strcmp( n, "CMenuPlayerSetup" ) ||
+	       !strcmp( n, "CMenuControls" ) || !strcmp( n, "CAdvancedControls" ) ||
+	       !strcmp( n, "CMenuAudio" ) || !strcmp( n, "CMenuVideo" ) ||
+	       !strcmp( n, "CMenuVidModes" ) || !strcmp( n, "CMenuVidOptions" ) ||
+	       !strcmp( n, "CMenuGameOptions" ) || !strcmp( n, "CMenuCrosshair" );
+}
+
+static int GetSettingsTabIndex( const char *n )
+{
+	if( !strcmp( n, "CMenuPlayerSetup" ) || !strcmp( n, "CMenuCrosshair" ) || !strcmp( n, "CMenuOptions" ) ) return 0;
+	if( !strcmp( n, "CMenuControls" ) ) return 1;
+	if( !strcmp( n, "CAdvancedControls" ) ) return 2;
+	if( !strcmp( n, "CMenuAudio" ) ) return 3;
+	if( !strcmp( n, "CMenuVidModes" ) || !strcmp( n, "CMenuVideo" ) ) return 4;
+	if( !strcmp( n, "CMenuVidOptions" ) ) return 5;
+	if( !strcmp( n, "CMenuGameOptions" ) ) return 6;
+	return 0;
+}
+
+static const char *g_vguiSettingsTabs[7] = {
+	"Multiplayer", "Keyboard", "Mouse", "Audio", "Video", "Quality", "Network"
+};
+
+static void DrawVguiBevelBox( int x, int y, int w, int h, unsigned int bg, bool inset )
+{
+	unsigned int tl = inset ? 0xFF222528 : 0xFF6E737A;
+	unsigned int br = inset ? 0xFF6E737A : 0xFF222528;
+	UI_FillRect( x, y, w, h, bg );
+	UI_FillRect( x, y, w, 1, tl );
+	UI_FillRect( x, y, 1, h, tl );
+	UI_FillRect( x, y + h - 1, w, 1, br );
+	UI_FillRect( x + w - 1, y, 1, h, br );
+}
