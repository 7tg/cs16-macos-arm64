+	int idx = 0;
+	for( int i = 0; i < (int)ARRAYSIZE( g_bgModels ); i++ )
+		if( !strcmp( g_bgModels[i], mdl )) idx = i;
+
+	const char *wpn = EngFuncs::GetCvarString( "ui_bg_weapon" );
+	int widx = 0;
+	for( int i = 0; i < (int)ARRAYSIZE( g_bgWeapons ); i++ )
+		if( !strcmp( g_bgWeapons[i].id, wpn )) widx = i;
+
+	snprintf( bgMapLabel, sizeof( bgMapLabel ), "Map: %s", EngFuncs::GetCvarString( "ui_bg_map" ));
+	snprintf( bgModelLabel, sizeof( bgModelLabel ), "Agent: %s (%s)", g_bgModels[idx], idx < g_bgModelCT ? "CT" : "T" );
+	snprintf( bgWeaponLabel, sizeof( bgWeaponLabel ), "Weapon: %s", g_bgWeapons[widx].label );
+	bgMapBtn.SetNameAndStatus( bgMapLabel, NULL );
+	bgModelBtn.SetNameAndStatus( bgModelLabel, NULL );
+	bgWeaponBtn.SetNameAndStatus( bgWeaponLabel, NULL );
+}
+
+void CMenuMain::ApplyBgModel()
+{
+	if( !view.ent ) return;
+
+	const char *mdl = EngFuncs::GetCvarString( "ui_bg_model" );
+	char path[128];
+	snprintf( path, sizeof( path ), "models/player/%s/%s.mdl", mdl, mdl );
+	EngFuncs::SetModel( view.ent, path );
+
+	const char *wpn = EngFuncs::GetCvarString( "ui_bg_weapon" );
+	int widx = 0;
+	for( int i = 0; i < (int)ARRAYSIZE( g_bgWeapons ); i++ )
+		if( !strcmp( g_bgWeapons[i].id, wpn )) widx = i;
+
+	view.ent->curstate.sequence = g_bgWeapons[widx].seq;
+	view.ent->curstate.gaitsequence = 1; // idle1 standing legs
+	view.ent->curstate.blending[0] = 127;
+	view.ent->curstate.blending[1] = 127;
+	view.ent->latched.prevblending[0] = 127;
+	view.ent->latched.prevblending[1] = 127;
+	view.SetWeaponModel( g_bgWeapons[widx].mdl );
+	modelDirty = false;
+}
+
+void CMenuMain::CycleBgModel()
+{
+	const char *mdl = EngFuncs::GetCvarString( "ui_bg_model" );
+	int idx = 0;
+	for( int i = 0; i < (int)ARRAYSIZE( g_bgModels ); i++ )
+		if( !strcmp( g_bgModels[i], mdl )) idx = i;
+
+	idx = ( idx + 1 ) % ARRAYSIZE( g_bgModels );
+	EngFuncs::CvarSetString( "ui_bg_model", g_bgModels[idx] );
+	EngFuncs::CvarSetString( "ui_bg_weapon", idx < g_bgModelCT ? "m4a1" : "ak47" );
+	modelDirty = true;
+	UpdateBgLabels();
+}
+
+void CMenuMain::CycleBgWeapon()
+{
+	const char *wpn = EngFuncs::GetCvarString( "ui_bg_weapon" );
+	int widx = 0;
+	for( int i = 0; i < (int)ARRAYSIZE( g_bgWeapons ); i++ )
+		if( !strcmp( g_bgWeapons[i].id, wpn )) widx = i;
+
+	widx = ( widx + 1 ) % ARRAYSIZE( g_bgWeapons );
+	EngFuncs::CvarSetString( "ui_bg_weapon", g_bgWeapons[widx].id );
+	modelDirty = true;
+	UpdateBgLabels();
+}
+
+void CMenuMain::CycleBgMap()
+{
+	int num = 0;
+	char **files = EngFuncs::GetFilesList( "maps/*.bsp", &num, true );
+	if( !files || num <= 0 ) return;
+
+	const char *cur = EngFuncs::GetCvarString( "ui_bg_map" );
+	int curIdx = -1;
+	char name[64];
+
+	for( int i = 0; i < num; i++ )
+	{
+		const char *s = strrchr( files[i], '/' );
+		s = s ? s + 1 : files[i];
+		snprintf( name, sizeof( name ), "%s", s );
+		char *dot = strrchr( name, '.' );
+		if( dot ) *dot = 0;
+		if( !strcmp( name, cur )) curIdx = i;
+	}
+
+	const char *s = strrchr( files[( curIdx + 1 ) % num], '/' );
+	s = s ? s + 1 : files[( curIdx + 1 ) % num];
+	snprintf( name, sizeof( name ), "%s", s );
+	char *dot = strrchr( name, '.' );
+	if( dot ) *dot = 0;
+
+	EngFuncs::CvarSetString( "ui_bg_map", name );
+	UpdateBgLabels();
+
+	if( !CL_IsActive( ))
+	{
+		char cmd[96];
+		snprintf( cmd, sizeof( cmd ), "map_background %s\n", name );
+		EngFuncs::ClientCmd( false, cmd );
+	}
+}
