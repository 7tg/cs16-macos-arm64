+bool CMenuFramework::KeyUp( int key )
+{
+	if( UI::Key::IsLeftMouse( key ) && strcmp( szName, "CMenuMain" ) != 0 )
+	{
+		const float sx = uiStatic.scaleX, sy = uiStatic.scaleY;
+		const int wx = (int)( ( uiStatic.xOffset + 48 ) * sx );
+		const int wy = (int)( ( uiStatic.yOffset + 52 ) * sy );
+		const int ww = (int)( 928 * sx );
+		const int closeX = wx + ww - (int)( 28 * sx );
+		const int closeY = wy + (int)( 8 * sy );
+		const int closeSz = (int)( 20 * sy );
+		if( UI_CursorInRect( Point( closeX, closeY ), Size( closeSz, closeSz ) ) )
+		{
+			Hide();
+			return true;
+		}
+
+		if( IsSettingsTabMenu( szName ) )
+		{
+			const int ix = wx + (int)( 14 * sx );
+			const int tabY = wy + (int)( 36 * sy );
+			const int tabW = (int)( 118 * sx );
+			const int tabH = (int)( 34 * sy );
+			const int activeTab = GetSettingsTabIndex( szName );
+			for( int t = 0; t < 7; t++ )
+			{
+				int tx = ix + t * ( tabW + (int)( 2 * sx ) );
+				if( UI_CursorInRect( Point( tx, tabY - 2 ), Size( tabW, tabH ) ) )
+				{
+					if( t != activeTab )
+					{
+						CMenuFramework *oldMenu = this;
+						switch( t )
+						{
+						case 0: UI_PlayerSetup_Menu(); break;
+						case 1: UI_Controls_Menu(); break;
+						case 2: UI_AdvControls_Menu(); break;
+						case 3: UI_Audio_Menu(); break;
+						case 4: UI_VidModes_Menu(); break;
+						case 5: UI_VidOptions_Menu(); break;
+						case 6: UI_GameOptions_Menu(); break;
+						}
+						oldMenu->DisableTransition();
+						SetBits( oldMenu->iFlags, QMF_CLOSING );
+					}
+					return true;
+				}
+			}
+		}
+	}
+	return BaseClass::KeyUp( key );
+}
