+// XASH3D_DISPLAY=<part of display name> picks the monitor for the initial window (default: primary)
+static SDL_DisplayID VID_GetTargetDisplay( void )
+{
+	const char *want = SDL_getenv( "XASH3D_DISPLAY" );
+
+	if( want && *want )
+	{
+		SDL_DisplayID found = 0;
+		int           count = 0;
+		SDL_DisplayID *ids = SDL_GetDisplays( &count );
+
+		for( int i = 0; ids && i < count && !found; i++ )
+		{
+			const char *name = SDL_GetDisplayName( ids[i] );
+
+			if( name && SDL_strcasestr( name, want ))
+				found = ids[i];
+		}
+
+		SDL_free( ids );
+
+		if( found )
+			return found;
+	}
+
+	return SDL_GetPrimaryDisplay();
+}
